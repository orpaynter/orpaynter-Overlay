            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "event_hash": {
          "$ref": "#/$defs/hash"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
