        },
        "event_type": {
          "type": "string"
        },
        "actor": {
          "$ref": "#/$defs/actor"
        },
        "occurred_at": {
          "type": "string",
          "format": "date-time"
        },
        "input_hash": {
          "$ref": "#/$defs/hash"
        },
        "output_hash": {
          "$ref": "#/$defs/hash"
        },
        "previous_event_hash": {
          "type": [
